# ── 클라이언트 (Vite, 브라우저에 노출됨) ──
VITE_KAKAO_API_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# 로컬에서 Vite만 띄울 때 리뷰 API 오리진 (예: vercel dev 주소). 배포 시 비워 둠
VITE_API_ORIGIN=
VITE_ADSENSE_CLIENT_ID=

# ── 서버 (Vercel Serverless, 브라우저에 노출되지 않음) ──
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# IP 해시에 섞는 비밀 값. 비워도 동작하지만 운영(Vercel Production·Preview)에는 반드시 설정
# 생성 예: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
REVIEW_IP_PEPPER=
# CORS 추가 허용 출처(쉼표 구분). 기본 허용: https://chosun-food-map.vercel.app, http://localhost:3000
# 커스텀 도메인을 붙였을 때만 설정 (예: https://food.example.com)
ALLOWED_ORIGIN=
